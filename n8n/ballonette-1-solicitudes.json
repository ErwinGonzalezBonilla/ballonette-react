    {
      "id": "cfe8bced-9749-4a53-939f-25ae557f22d7",
      "name": "Preparar foto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        180
      ],
      "parameters": {
        "jsCode": "// Convierte la foto que manda la web (data URL en base64) en un archivo adjunto\nconst body = $('Solicitud de Balloonbot').first().json.body;\nconst [cabecera, datos] = body.foto_referencia.split(',');\nconst mime = cabecera.slice(5).split(';')[0];\nconst ext = mime.split('/')[1].replace('jpeg', 'jpg');\nconst foto = await this.helpers.prepareBinaryData(Buffer.from(datos, 'base64'), 'foto-referencia.' + ext, mime);\nreturn [{ json: {}, binary: { foto } }];"
      }
    },
